<?xml version="1.0" encoding="utf-8"?>
<!--
  NeonHearth Windows 11 x64 installer definition (WiX v4).

  Build (after running packaging\stage.ps1 to produce packaging\dist\windows):

    wix extension add -g WixToolset.Util.wixext/5.0.2
    wix build packaging\windows\NeonHearth.wxs ^
        -ext WixToolset.Util.wixext ^
        -bindpath dist=%CD%\packaging\dist\windows ^
        -arch x64 ^
        -d MsiVersion=0.1.0 ^
        -wx ^
        -o packaging\dist\NeonHearth-0.1.0-x64.msi

  The bindpath MUST be an absolute path: the <Files> wildcard harvest below
  resolves a relative bindpath against this .wxs file's directory, not the
  working directory, and a miss is only warning WIX8601 (empty ui payload).
  -wx promotes that warning to a build failure.

  REQUIRES WiX v5+ (pinned to 5.0.2 in .github/workflows/release.yml): the
  <Files> wildcard-harvesting element used for the UI bundle does not exist
  in WiX 4.x (verified: wix 4.0.6 fails with WIX0005 on it; wix 5.0.2
  builds this file cleanly).

  MsiVersion must be a numeric x.y.z (MSI ProductVersion cannot carry a
  semver prerelease suffix like -alpha.1; the release workflow strips it
  and keeps the full version only in the output filename).

  STATUS: `wix build` (5.0.2) of this file succeeds on the build machine and
  the resulting MSI's file layout was verified via `msiexec /a` extraction.
  A real install/uninstall on a clean machine has still not been performed.

  Reality this authoring is based on (verified in source):
  - The service binary is crates/lattice-service (main.rs). It requires the
    LATTICE_SERVICE_TOKEN environment variable and binds 127.0.0.1:58120
    (loopback) only. It has NO built-in service install mechanism, so MSI
    ServiceInstall registers it.
  - The binary only speaks the SCM protocol (StartServiceCtrlDispatcher via
    win_service.rs) when launched with the service flag (Arguments below);
    without it the exe is a plain console app. ServiceInstall therefore MUST
    pass the flag: the first real installs omitted it and every start timed
    out with SCM events 7009/7000 (no ServiceMain ever registered).
  - NO Windows Firewall rule is authored, deliberately: the listener is
    loopback-only and Windows Firewall does not filter loopback traffic.
    If a LAN listener is ever added, an inbound rule must be added then.
  - The executable is linked against Npcap's Packet.dll (pnet_datalink), so
    Npcap absence is a load-time failure, not a runtime degradation. The
    configure-service.ps1 custom action therefore implements "limited mode"
    by leaving the service registered but Manual/stopped when Npcap is
    missing, and writes %ProgramData%\NeonHearth\NPCAP-REQUIRED.txt.
  - Service state lives in %ProgramData%\NeonHearth (platform.rs). Uninstall
    leaves it in place; configure-service.ps1 writes README-UNINSTALL.txt
    there explaining that.
  - UI assets (apps/desktop Vite bundle) are installed under ui\ and the
    service serves them at http://127.0.0.1:58120/ when LATTICE_UI_DIR is set
    in its private Environment registry value (configure-service.ps1 writes
    it pointing at [INSTALLFOLDER]ui). The Start-menu "NeonHearth" shortcut
    runs open-neonhearth.ps1 to open the dashboard pre-paired via a URL
    fragment token.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- Numeric MSI version, overridable from the command line with
       -d MsiVersion=x.y.z (the release workflow derives it from the tag). -->
  <?ifndef MsiVersion ?>
    <?define MsiVersion = "0.1.0" ?>
  <?endif ?>

  <Package Name="NeonHearth"
           Manufacturer="NeonHearth Project"
           Version="$(var.MsiVersion)"
           UpgradeCode="6f1f9d3e-52aa-4f3b-9b0a-3d2f4bfae8c1"
           Scope="perMachine"
           Compressed="yes">

    <!-- AllowSameVersionUpgrades is REQUIRED while releases are alpha-tagged:
         MSI ProductVersion carries only the numeric x.y.z (0.1.0 for both
         v0.1.0-alpha.4 and v0.1.0-alpha.5), and without it a same-version
         install is neither an upgrade nor a downgrade — Windows installs a
         SECOND copy side by side instead of replacing the old one. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of NeonHearth is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Npcap presence: WinPcap-compatible Packet.dll in System32. The
         configure-service.ps1 custom action performs the authoritative
         check (it also looks in System32\Npcap); this property only feeds
         the summary log. -->
    <Property Id="NPCAP_COMPAT_PRESENT">
      <DirectorySearch Id="System64Search" Path="[System64Folder]">
        <FileSearch Id="PacketDllSearch" Name="Packet.dll" />
      </DirectorySearch>
    </Property>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="NeonHearth">
        <Directory Id="UIFOLDER" Name="ui" />
        <Directory Id="SCRIPTSFOLDER" Name="scripts" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="ServiceComponents" Directory="INSTALLFOLDER">
      <Component Id="ServiceExecutable" Guid="6a7f0f92-1f0c-4c85-a67d-5cf1b2f27a11" Bitness="always64">
        <File Id="LatticeServiceExe" Source="!(bindpath.dist)\bin\lattice-service.exe" KeyPath="yes" />
        <!-- Dedicated service identity: the NT SERVICE\NeonHearth virtual
             account (matches docs/architecture/privilege-boundary.md).
             Start=auto is the with-Npcap default; configure-service.ps1
             demotes it to demand when Npcap is absent (limited mode) and
             performs the actual start, so no ServiceControl Start here. -->
        <!-- The Arguments flag selects the SCM dispatcher entry point in
             the binary (win_service.rs). Without it the exe runs as a console
             app, never calls StartServiceCtrlDispatcher, and the SCM start
             times out (events 7009/7000, observed on the first installs). -->
        <ServiceInstall Id="NeonHearthService"
                        Name="NeonHearth"
                        DisplayName="NeonHearth Collector"
                        Description="NeonHearth home-network collector service (loopback API on 127.0.0.1:58120)."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="NT SERVICE\NeonHearth"
                        Arguments="--service"
                        Vital="yes">
          <!-- Restart-on-failure recovery (mirrored by sc.exe in
               configure-service.ps1 for resilience if this extension
               element is unavailable). -->
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="5"
                              ResetPeriodInDays="1" />
        </ServiceInstall>
        <!-- Clean uninstall: stop and delete the service. -->
        <ServiceControl Id="NeonHearthServiceControl"
                        Name="NeonHearth"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

    <!-- Desktop UI bundle staged by packaging\stage.ps1 (Vite build of
         apps/desktop). WiX v4 wildcard harvesting. -->
    <ComponentGroup Id="UiAssets" Directory="UIFOLDER">
      <Files Include="!(bindpath.dist)\ui\**" />
    </ComponentGroup>

    <ComponentGroup Id="InstallScripts" Directory="SCRIPTSFOLDER">
      <Component Id="ConfigureScript" Guid="b3f57a24-9c1e-4dd2-8a0b-77d0f2f4c9a2" Bitness="always64">
        <File Id="ConfigureServicePs1" Source="!(bindpath.dist)\scripts\configure-service.ps1" KeyPath="yes" />
      </Component>
      <Component Id="LauncherScript" Guid="4c2a8e17-6b3d-4f5e-9a21-8e0d5b6c1f43" Bitness="always64">
        <File Id="OpenNeonHearthPs1" Source="!(bindpath.dist)\scripts\open-neonhearth.ps1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Start-menu entry (all-users). A non-advertised shortcut to
         powershell.exe running open-neonhearth.ps1, which reads the pairing
         token from the service's Environment registry value (self-elevating
         with a UAC prompt when the read is denied) and opens the dashboard
         at http://127.0.0.1:58120/#token=... in the default browser.
         Target is given explicitly, so WiX authors this as a regular
         (Advertise=no) shortcut; the component keypath is a registry value
         because a shortcut cannot be its own keypath. -->
    <ComponentGroup Id="StartMenuShortcuts" Directory="ProgramMenuFolder">
      <Component Id="NeonHearthStartMenuShortcut" Guid="9d4b1f6a-2c7e-48d3-b5a9-0f8c3e7d2a15" Bitness="always64">
        <Shortcut Id="NeonHearthShortcut"
                  Name="NeonHearth"
                  Description="Open the NeonHearth dashboard"
                  Target="[System64Folder]WindowsPowerShell\v1.0\powershell.exe"
                  Arguments="-NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -File &quot;[SCRIPTSFOLDER]open-neonhearth.ps1&quot;"
                  WorkingDirectory="SCRIPTSFOLDER" />
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\NeonHearth"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Post-registration configuration: token generation, state-dir ACL,
         Npcap detection / limited mode, recovery settings, data-retention
         note, and service start when Npcap is present. Deferred + no
         impersonation so it runs elevated after InstallServices. -->
    <SetProperty Id="ConfigureNeonHearthService"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[SCRIPTSFOLDER]configure-service.ps1&quot; -Start"
                 Sequence="execute"
                 Before="ConfigureNeonHearthService" />
    <CustomAction Id="ConfigureNeonHearthService"
                  DllEntry="WixQuietExec64"
                  BinaryRef="Wix4UtilCA_X64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <InstallExecuteSequence>
      <Custom Action="ConfigureNeonHearthService"
              After="InstallServices"
              Condition="NOT Installed OR REINSTALL" />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="NeonHearth" Level="1">
      <ComponentGroupRef Id="ServiceComponents" />
      <ComponentGroupRef Id="UiAssets" />
      <ComponentGroupRef Id="InstallScripts" />
      <ComponentGroupRef Id="StartMenuShortcuts" />
    </Feature>
  </Package>
</Wix>
