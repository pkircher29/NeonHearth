# NeonHearth collector service (systemd unit).
#
# Hardening rationale (matched against the current code, not aspiration):
# - The service binds 127.0.0.1:58120 only (crates/lattice-service/src/main.rs).
# - Discovery in this build reads the kernel neighbor table over rtnetlink
#   (RTM_GETNEIGH is an unprivileged read) and enumerates interfaces via
#   getifaddrs; it opens no raw sockets. Therefore NO ambient capabilities
#   are granted by default. CapabilityBoundingSet retains CAP_NET_RAW and
#   CAP_NET_ADMIN only so the documented "full capture mode"
#   (docs/architecture/privilege-boundary.md) can be enabled later with the
#   drop-in in /usr/share/doc/neonhearth/full-capture.conf.example without
#   editing this unit. AmbientCapabilities is preferred over setcap on the
#   binary so the privilege is visible and revocable in unit configuration.
# - State lives in /var/lib/neonhearth (StateDirectory) per platform.rs;
#   LATTICE_STATE_BASE=/var/lib is the binary's own default, set explicitly
#   here for auditability.
# - The pairing token is supplied via a root-owned 0600 EnvironmentFile
#   generated by the package postinstall script; the binary refuses to start
#   without LATTICE_SERVICE_TOKEN.
# - MemoryDenyWriteExecute is safe: lattice-service does not link a JIT
#   (the Wasmtime-based audit crate is not a dependency of this binary).

[Unit]
Description=NeonHearth home-network collector (loopback API on 127.0.0.1:58120)
Documentation=file:///usr/share/doc/neonhearth/
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=neonhearth
Group=neonhearth
ExecStart=/usr/libexec/neonhearth/lattice-service
EnvironmentFile=/etc/neonhearth/service.env
Environment=LATTICE_STATE_BASE=/var/lib

# State ownership
StateDirectory=neonhearth
StateDirectoryMode=0750
UMask=0077

# Privilege containment
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
AmbientCapabilities=
# Full capture mode drop-in sets: AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN

# Filesystem
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible

# Kernel/syscall surface
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# AF_NETLINK: rtnetlink neighbor/interface reads.
# AF_UNIX: local plumbing (journal, and keyring/secret-service if enabled).
# AF_PACKET is NOT granted; add it in the full-capture drop-in when live
# capture is actually wired to a packet socket.
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX

# Recovery
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
