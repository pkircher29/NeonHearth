#!/bin/sh
# Print the NeonHearth owner pairing token. Root only.
#
# Resolution order matches the service (crates/lattice-service/src/main.rs):
#   1. /var/lib/neonhearth/owner-token  (written by the service when the owner
#      rotates the token; owned by the service account, mode 0600)
#   2. LATTICE_SERVICE_TOKEN in /etc/neonhearth/service.env (install-time seed)
# Neither file is readable by ordinary users, and this helper does not change
# that. Never paste the output into logs or chat.
set -eu
STATE_DIR=/var/lib/neonhearth
ENV_FILE=/etc/neonhearth/service.env

if [ "$(id -u)" -ne 0 ]; then
    echo "neonhearth-token: run as root (for example: sudo neonhearth-token)" >&2
    exit 1
fi

# Same acceptance rule as the service: 32+ characters of [A-Za-z0-9._-].
valid() {
    [ "${#1}" -ge 32 ] || return 1
    case "$1" in
        *[!A-Za-z0-9._-]*) return 1 ;;
    esac
    return 0
}

token=""
file="$STATE_DIR/owner-token"
if [ -f "$file" ] && [ ! -L "$file" ]; then
    token="$(sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$file")"
fi
if [ -n "$token" ]; then
    if ! valid "$token"; then
        echo "neonhearth-token: $file is malformed; the service will not start with it. Delete it to fall back to $ENV_FILE." >&2
        exit 1
    fi
    printf '%s\n' "$token"
    exit 0
fi

if [ -f "$ENV_FILE" ] && [ ! -L "$ENV_FILE" ]; then
    token="$(sed -n 's/^LATTICE_SERVICE_TOKEN=//p' "$ENV_FILE" | head -n 1)"
fi
if [ -z "$token" ] || ! valid "$token"; then
    echo "neonhearth-token: no valid token found in $file or $ENV_FILE" >&2
    exit 1
fi
printf '%s\n' "$token"
