/.worktrees/
/target/
/node_modules/
/apps/desktop/node_modules/
/apps/desktop/dist/
/apps/desktop/playwright-report/
/apps/desktop/test-results/
/.env
/.env.*
!/\.env.example
*.db
*.db-shm
*.db-wal
# Packet captures are local evidence, never committed by default. The
# fixture captures under crates/lattice-sensor/tests/fixtures/pcap/ are the
# one intentional exception (see the negation below).
*.pcap
*.pcapng
!/crates/lattice-sensor/tests/fixtures/pcap/*.pcap
!/crates/lattice-sensor/tests/fixtures/pcap/*.pcapng
/artifacts/
/dist/
/.local/


__pycache__/
# Local build/test output (Playwright screenshots etc.); never committed.
/output/
